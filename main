<script>
(function(){
  const H = FLIGHT.header;
  const C = FLIGHT.columns;
  const n = C.time.length;

  const COLORS = {
    amber: '#f2a53c',
    cyan: '#4fd1c9',
    violet: '#9d90f2',
    rose: '#e2735f',
    green: '#6bcf8e',
    dim: '#7c8797',
    grid: '#232b37'
  };

  function fmt(v, d){
    if(v === null || v === undefined || Number.isNaN(v)) return '—';
    return Number(v).toFixed(d === undefined ? 2 : d);
  }

  function colStats(name){
    const vals = C[name].filter(v => v !== null && v !== undefined);
    if(vals.length === 0) return null;
    return {
      min: Math.min(...vals),
      max: Math.max(...vals),
      first: vals[0],
      last: vals[vals.length-1],
      count: vals.length
    };
  }

  // ---------- header meta ----------
  document.getElementById('routeTag').textContent = C.route[0] || '—';
  document.getElementById('metaDate').textContent = (C.date[0] || '').slice(0,10);
  document.getElementById('metaStart').textContent = C.time_day[0] || '—';
  document.getElementById('metaSamples').textContent = n + ' rows';

  // ---------- stat strip ----------
  const duration = C.time[n-1] - C.time[0];
  const battStats = colStats('battery_voltage');
  const speedStats = colStats('speed');
  const altStats = colStats('position_z');

  const stats = [
    { label:'duration', value:fmt(duration,1), unit:'s' },
    { label:'samples', value:String(n), unit:'' },
    { label:'setpoint alt', value:fmt(C.altitude[0],2), unit:'m', accent:'amber' },
    { label:'peak altitude', value: altStats ? fmt(altStats.max,2) : '—', unit:'m', accent:'amber' },
    { label:'peak speed', value: speedStats ? fmt(speedStats.max,2) : '—', unit:'m/s', accent:'cyan' },
    { label:'battery drop', value: battStats ? fmt(battStats.first - battStats.last,2) : '—', unit:'V', accent:'violet' },
  ];

  const stripEl = document.getElementById('statStrip');
  stats.forEach(s => {
    const div = document.createElement('div');
    div.className = 'stat' + (s.accent ? ' accent-' + s.accent : '');
    div.innerHTML = `<div class="label">${s.label}</div><div class="value">${s.value}<span class="unit">${s.unit}</span></div>`;
    stripEl.appendChild(div);
  });

  // ---------- chart defaults ----------
  Chart.defaults.font.family = "'IBM Plex Mono', monospace";
  Chart.defaults.font.size = 10.5;
  Chart.defaults.color = COLORS.dim;

  const baseGrid = {
    color: COLORS.grid,
    drawTicks: false
  };

  function baseOptions(extra){
    return Object.assign({
      responsive:true,
      maintainAspectRatio:false,
      animation:false,
      interaction:{ mode:'index', intersect:false },
      plugins:{
        legend:{ display:false },
        tooltip:{
          backgroundColor:'#1b2230',
          borderColor:'#2a3341',
          borderWidth:1,
          titleColor:'#e7ecf3',
          bodyColor:'#c3ccd6',
          padding:8,
          titleFont:{ family:"'IBM Plex Mono', monospace", size:11 },
          bodyFont:{ family:"'IBM Plex Mono', monospace", size:11 }
        }
      },
      scales:{
        x:{ grid: baseGrid, ticks:{ maxTicksLimit:6 }, title:{ display:true, text:'time (s)', color:COLORS.dim, font:{size:10} } },
        y:{ grid: baseGrid, ticks:{ maxTicksLimit:5 } }
      }
    }, extra || {});
  }

  function lineDataset(label, data, color, extra){
    return Object.assign({
      label, data, borderColor:color, backgroundColor:color,
      borderWidth:1.6, pointRadius:0, pointHoverRadius:3, tension:0.15
    }, extra || {});
  }

  function legendRow(panelId, items){
    const panel = document.getElementById(panelId).closest('.panel');
    const row = document.createElement('div');
    row.className = 'legend-row';
    row.innerHTML = items.map(it => `<span class="item"><span class="swatch" style="background:${it.color}"></span>${it.label}</span>`).join('');
    panel.appendChild(row);
  }

  const time = C.time;

  // ---------- altitude ----------
  new Chart(document.getElementById('chartAltitude'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('altitude', C.position_z, COLORS.amber, { fill:{target:'origin', above:'rgba(242,165,60,0.08)'} }),
    ]},
    options: baseOptions({
      scales:{
        x:{ grid: baseGrid, ticks:{maxTicksLimit:6}, title:{display:true,text:'time (s)',color:COLORS.dim,font:{size:10}} },
        y:{ grid: baseGrid, ticks:{maxTicksLimit:5}, title:{display:true,text:'m',color:COLORS.dim,font:{size:10}} }
      }
    })
  });

  // ---------- ground track ----------
  const trackPoints = C.position_x.map((x,i) => ({x, y:C.position_y[i]})).filter(p => p.x !== null && p.y !== null);
  new Chart(document.getElementById('chartTrack'), {
    type:'line',
    data:{ datasets:[
      { label:'track', data:trackPoints, borderColor:COLORS.cyan, backgroundColor:'transparent', borderWidth:1.6, pointRadius:0, showLine:true, tension:0.1, parsing:false },
      { label:'start', data:[trackPoints[0]], borderColor:COLORS.green, backgroundColor:COLORS.green, pointRadius:5, pointStyle:'circle', showLine:false, parsing:false },
      { label:'end', data:[trackPoints[trackPoints.length-1]], borderColor:COLORS.rose, backgroundColor:COLORS.rose, pointRadius:5, pointStyle:'rectRot', showLine:false, parsing:false }
    ]},
    options: baseOptions({
      scales:{
        x:{ type:'linear', grid: baseGrid, ticks:{maxTicksLimit:6}, title:{display:true,text:'position_x (m)',color:COLORS.dim,font:{size:10}} },
        y:{ type:'linear', grid: baseGrid, ticks:{maxTicksLimit:5}, title:{display:true,text:'position_y (m)',color:COLORS.dim,font:{size:10}} }
      },
      plugins:{ legend:{display:false}, tooltip:{ enabled:true, callbacks:{ label: ctx => `x ${fmt(ctx.parsed.x,3)}, y ${fmt(ctx.parsed.y,3)}` } } }
    })
  });
  legendRow('chartTrack', [
    {label:'flight path', color:COLORS.cyan},
    {label:'start', color:COLORS.green},
    {label:'end', color:COLORS.rose}
  ]);

  // ---------- speed ----------
  new Chart(document.getElementById('chartSpeed'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('speed', C.speed, COLORS.cyan, { fill:{target:'origin', above:'rgba(79,209,201,0.08)'} })
    ]},
    options: baseOptions({
      scales:{
        x:{ grid: baseGrid, ticks:{maxTicksLimit:6}, title:{display:true,text:'time (s)',color:COLORS.dim,font:{size:10}} },
        y:{ grid: baseGrid, ticks:{maxTicksLimit:5}, title:{display:true,text:'m/s',color:COLORS.dim,font:{size:10}} }
      }
    })
  });

  // ---------- battery ----------
  new Chart(document.getElementById('chartBattery'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('battery_voltage', C.battery_voltage, COLORS.violet)
    ]},
    options: baseOptions({
      scales:{
        x:{ grid: baseGrid, ticks:{maxTicksLimit:6}, title:{display:true,text:'time (s)',color:COLORS.dim,font:{size:10}} },
        y:{ grid: baseGrid, ticks:{maxTicksLimit:5}, title:{display:true,text:'V',color:COLORS.dim,font:{size:10}} }
      }
    })
  });

  // ---------- velocity ----------
  new Chart(document.getElementById('chartVelocity'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('vx', C.velocity_x, COLORS.amber),
      lineDataset('vy', C.velocity_y, COLORS.cyan),
      lineDataset('vz', C.velocity_z, COLORS.violet)
    ]},
    options: baseOptions()
  });
  legendRow('chartVelocity', [
    {label:'vx', color:COLORS.amber}, {label:'vy', color:COLORS.cyan}, {label:'vz', color:COLORS.violet}
  ]);

  // ---------- angular rate ----------
  new Chart(document.getElementById('chartAngular'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('ωx', C.angular_x, COLORS.amber),
      lineDataset('ωy', C.angular_y, COLORS.cyan),
      lineDataset('ωz', C.angular_z, COLORS.violet)
    ]},
    options: baseOptions()
  });
  legendRow('chartAngular', [
    {label:'ωx', color:COLORS.amber}, {label:'ωy', color:COLORS.cyan}, {label:'ωz', color:COLORS.violet}
  ]);

  // ---------- linear acceleration ----------
  new Chart(document.getElementById('chartAccel'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('ax', C.linear_acceleration_x, COLORS.amber),
      lineDataset('ay', C.linear_acceleration_y, COLORS.cyan),
      lineDataset('az', C.linear_acceleration_z, COLORS.violet)
    ]},
    options: baseOptions()
  });
  legendRow('chartAccel', [
    {label:'ax', color:COLORS.amber}, {label:'ay', color:COLORS.cyan}, {label:'az (incl. gravity)', color:COLORS.violet}
  ]);

  // ---------- orientation ----------
  new Chart(document.getElementById('chartOrientation'), {
    type:'line',
    data:{ labels:time, datasets:[
      lineDataset('qx', C.orientation_x, COLORS.amber),
      lineDataset('qy', C.orientation_y, COLORS.cyan),
      lineDataset('qz', C.orientation_z, COLORS.violet),
      lineDataset('qw', C.orientation_w, COLORS.rose)
    ]},
    options: baseOptions()
  });
  legendRow('chartOrientation', [
    {label:'qx', color:COLORS.amber}, {label:'qy', color:COLORS.cyan}, {label:'qz', color:COLORS.violet}, {label:'qw', color:COLORS.rose}
  ]);

  // ---------- note bar ----------
  const allNull = H.filter(h => C[h].every(v => v === null || v === undefined));
  document.getElementById('noteBar').innerHTML =
    `<strong>Not logged this flight:</strong> ${allNull.join(', ')} — every value came back empty in the source sheet, so these columns are omitted from the charts above but are still included in the full log table below.`;

  // ---------- table ----------
  document.getElementById('tableCount').textContent = `${n} rows × ${H.length} cols`;
  const headRow = document.getElementById('tableHeadRow');
  headRow.innerHTML = H.map(h => `<th>${h}</th>`).join('');

  const body = document.getElementById('tableBody');
  const frag = document.createDocumentFragment();
  for(let i=0;i<n;i++){
    const tr = document.createElement('tr');
    let html = '';
    for(const h of H){
      const v = C[h][i];
      if(v === null || v === undefined){
        html += `<td class="null-cell">—</td>`;
      } else if(typeof v === 'number'){
        html += `<td>${Number.isInteger(v) ? v : v.toFixed(4)}</td>`;
      } else {
        html += `<td>${v}</td>`;
      }
    }
    tr.innerHTML = html;
    frag.appendChild(tr);
  }
  body.appendChild(frag);

  const toggle = document.getElementById('tableToggle');
  const wrap = document.getElementById('tableWrap');
  toggle.addEventListener('click', () => {
    toggle.classList.toggle('open');
    wrap.classList.toggle('open');
  });
})();

</script>
</body>
</html>
